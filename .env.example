# ============================================================
# TrunkJunk — Environment Configuration
# Copy to .env and fill in. NEVER commit the real .env.
# ============================================================

# ---- Supabase ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...           # server-only, never ship to client
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
SUPABASE_PROJECT_REF=YOUR-PROJECT

# ---- Expo / React Native (must be EXPO_PUBLIC_ prefixed for client access) ----
EXPO_PUBLIC_SUPABASE_URL=$SUPABASE_URL
EXPO_PUBLIC_SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
EXPO_PUBLIC_APP_ENV=development

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=$STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_CLIENT_ID=ca_...

# ---- Twilio (phone OTP verification) ----
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_VERIFY_SID=VA...

# ---- Cloudflare R2 (media storage) ----
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=trunkjunk-media
R2_PUBLIC_URL=https://media.trunkjunk.app

# ---- OpenAI (PII redaction & moderation) ----
OPENAI_API_KEY=sk-...
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_REDACTION_MODEL=gpt-4o-mini

# ---- Sentry ----
SENTRY_DSN_MOBILE=https://...@sentry.io/...
SENTRY_DSN_ADMIN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=...

# ---- PostHog (product analytics) ----
EXPO_PUBLIC_POSTHOG_KEY=phc_...
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---- Admin app ----
ADMIN_ALLOWED_EMAILS=you@trunkjunk.app
NEXT_PUBLIC_SUPABASE_URL=$SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
